# Pomen environment variables. Copy to .env (or set inline in systemd unit).
# See docs/SETUP.md for full reference.

# Production: Unix socket path provided by the Intermasq host.
# When set, Pomen listens on this unix socket and ignores POMEN_DEV_PORT.
# PLUGIN_SOCKET=/run/intermasq/sockets/pomen.sock

# Dev / CI: TCP port for local testing without the Intermasq host.
# MUST NOT be set in production — no unix socket, no auth proxy in front.
# POMEN_DEV_PORT=18999

# Override state files location. Defaults point to /etc/intermasq/plugins/pomen.
# STATE_FILE=/etc/intermasq/plugins/pomen/routes.json
# VMS_FILE=/etc/intermasq/plugins/pomen/vms.json
